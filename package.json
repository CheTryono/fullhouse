{
  "name": "fullhouse",
  "version": "0.9.0",
  "private": true,
  "scripts": {
    "test": "node --test tests/*.test.cjs",
    "test:regression": "node --test tests/regression.test.cjs",
    "test:known-bugs": "node --test tests/known-bugs.test.cjs",
    "check": "tsc -p tsconfig.json --noEmit && node --check app.js && node scripts/check-build.cjs",
    "check:history-contract": "tsc -p contracts/tsconfig.json",
    "test:history-contract": "node --test tests/history-contract*.test.cjs"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "typescript": "5.9.3"
  }
}
