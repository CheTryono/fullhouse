{
  "name": "fullhouse",
  "version": "0.9.0",
  "private": true,
  "scripts": {
    "test": "node --test tests/*.test.cjs",
    "test:regression": "node --test tests/regression.test.cjs",
    "test:known-bugs": "node --test tests/known-bugs.test.cjs",
    "check": "tsc -p tsconfig.json --noEmit && node --check app.js && node scripts/check-build.cjs",
    "check:history-contract": "tsc -p contracts/tsconfig.json",
    "test:history-contract": "node --test tests/history-contract*.test.cjs",
    "check:auth": "tsc -p auth/tsconfig.json",
    "build:staging": "node scripts/build-auth-staging.cjs",
    "build:staging:emulator": "node scripts/build-auth-staging.cjs --emulator",
    "dev:auth": "node scripts/test-auth-staging.cjs --serve",
    "test:auth": "node --test tests/auth-*.test.cjs",
    "test:auth:emulator": "node scripts/test-auth-staging.cjs",
    "check:remote": "node scripts/build-remote-validator.cjs --check && node --check remote/contract.cjs && node --check remote/service.cjs && node --check remote/index.cjs",
    "test:remote": "node --test tests/remote-unit.test.cjs",
    "test:remote:emulator": "node scripts/test-remote-emulators.cjs",
    "check:remote-client": "tsc -p remote-client/tsconfig.json",
    "test:remote-client": "node --test tests/remote-client.test.cjs",
    "test:remote-durable": "node --test tests/durable-work.test.cjs",
    "build:remote-lab": "node scripts/build-remote-lab.cjs",
    "build:remote-staging": "node scripts/build-remote-staging.cjs",
    "test:remote-staging": "node --test tests/commercial-staging.test.cjs",
    "test:remote:planner": "node scripts/test-remote-emulators.cjs --planner",
    "test:remote:planner:simulated": "node scripts/test-remote-emulators.cjs --planner --simulated-data",
    "test:remote:planner:browser": "node scripts/test-remote-emulators.cjs --planner --browser",
    "test:remote:planner:browser:simulated": "node scripts/test-remote-emulators.cjs --planner --browser --simulated-data",
    "test:remote:durable:browser": "node scripts/test-remote-emulators.cjs --planner --browser --durable",
    "test:remote:durable:browser:simulated": "node scripts/test-remote-emulators.cjs --planner --browser --durable --simulated-data",
    "dev:remote": "node scripts/test-remote-emulators.cjs --planner --serve",
    "test:remote-staging:rules": "node scripts/test-remote-staging-rules.cjs",
    "check:remote-staging:node22": "node scripts/check-remote-staging-node22.cjs"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "fake-indexeddb": "6.2.8",
    "firebase-tools": "15.37.0",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "firebase": "13.4.0"
  },
  "overrides": {
    "firebase": {
      "@grpc/grpc-js": "1.14.7"
    }
  }
}
